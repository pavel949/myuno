{
  "name": "myuno",
  "description": "myUNO — Phuket Super-App for Foreigners. Доверенная цифровая инфраструктура для жизни, аренды и инвестиций иностранца на Пхукете: stays, services, property, investments в одном приложении.",
  "keywords": [
    "phuket",
    "thailand",
    "super-app",
    "real-estate",
    "off-plan",
    "clearview",
    "rental",
    "expat",
    "relocation",
    "myuno"
  ],
  "homepage": "https://myuno.app",
  "author": "Ignatev Group",
  "license": "UNLICENSED",
  "private": true,
  "version": "3.55.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:open": "vite --open",
    "dev:fresh": "vite --force",
    "prebuild": "node scripts/validate-fonts.mjs && node scripts/validate-service-tags.mjs && node scripts/validate-catalog-life-map.mjs && node scripts/generate-version.mjs",
    "build": "node --max-old-space-size=8192 node_modules/vite/bin/vite.js build",
    "build:dev": "node --max-old-space-size=8192 node_modules/vite/bin/vite.js build --mode development",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "validate:fonts": "node scripts/validate-fonts.mjs",
    "validate:fonts:verbose": "node scripts/validate-fonts.mjs --verbose",
    "validate:service-tags": "node scripts/validate-service-tags.mjs",
    "validate:service-tags:verbose": "node scripts/validate-service-tags.mjs --verbose",
    "validate:catalog-life-map": "node scripts/validate-catalog-life-map.mjs",
    "validate:catalog-life-map:verbose": "node scripts/validate-catalog-life-map.mjs --verbose",
    "validate:catalog-life-map:strict": "node scripts/validate-catalog-life-map.mjs --strict",
    "validate:semantic": "node scripts/validate-semantic.mjs",
    "validate:semantic:verbose": "node scripts/validate-semantic.mjs --verbose",
    "validate:semantic:strict": "node scripts/validate-semantic.mjs --strict",
    "supabase:deploy": "npx supabase functions deploy approve-partner-application && npx supabase functions deploy notify-admin-partner-application",
    "supabase:db-push": "npx supabase db push",
    "offplan:fetch-seed": "node scripts/fetch-offplan-seed.mjs",
    "offplan:import": "node scripts/import-offplan-catalog.mjs",
    "offplan:sync": "npm run offplan:fetch-seed && npm run offplan:import",
    "offplan:emit-sql": "node scripts/offplan-emit-sql-import.mjs"
  },
