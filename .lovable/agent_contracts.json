{
  "version": "1.0",
  "generated": "2026-01-30",
  "phase": "H",
  "contracts": [
    {
      "agent_id": "listing-quality-analyzer",
      "canonical_name": "Listing Quality Analyzer",
      "purpose": "Analyze listing completeness and quality to help admins prioritize moderation efforts",
      "target_audience": ["admin"],
      "domains": ["listings_catalog", "admin_operations"],
      
      "inputs": {
        "tables_read": [
          "yachts", "tours", "restaurants", "salons", "clinics", "gyms", 
          "vehicles", "events", "properties", "cleaning_services", 
          "babysitters", "flower_shops", "banks", "transfer_services"
        ],
        "fields_analyzed": [
          "name_en", "name_ru", "description_en", "description_ru",
          "images", "cover_image", "price", "rating", "review_count",
          "is_active", "is_verified", "approval_status"
        ],
        "context_provided": {
          "item_type": "string (vertical name)",
          "item_id": "uuid",
          "item_data": "JSON object with listing fields"
        }
      },
      
      "outputs": {
        "artifact_type": "listing_quality_report",
        "schema": {
          "type": "object",
          "required": ["overall_score", "completeness", "issues", "recommendations"],
          "properties": {
            "overall_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Overall quality score 0-100"
            },
            "completeness": {
              "type": "object",
              "properties": {
                "has_name_en": { "type": "boolean" },
                "has_name_ru": { "type": "boolean" },
                "has_description_en": { "type": "boolean" },
                "has_description_ru": { "type": "boolean" },
                "has_images": { "type": "boolean" },
                "image_count": { "type": "integer" },
                "has_price": { "type": "boolean" },
                "has_location": { "type": "boolean" }
              }
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "severity": { "type": "string", "enum": ["critical", "warning", "info"] },
                  "code": { "type": "string" },
                  "message_en": { "type": "string" },
                  "message_ru": { "type": "string" }
                }
              }
            },
            "recommendations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "action": { "type": "string" },
                  "impact": { "type": "string", "enum": ["high", "medium", "low"] }
                }
              }
            },
            "ai_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "storage": "ai_artifacts table (artifact_type = 'listing_quality_report')"
      },
      
      "trigger": {
        "events": [
          "admin.moderation.opened",
          "listing.submitted_for_approval",
          "admin.batch_analysis.requested"
        ],
        "frequency": "on-demand",
        "batch_support": true
      },
      
      "allowed_actions": [
        "Read listing data from any vertical table",
        "Generate quality report",
        "Store artifact to ai_artifacts",
        "Log invocation to ai_agent_logs"
      ],
      
      "forbidden_actions": [
        "UPDATE approval_status on any table",
        "DELETE any listing",
        "MODIFY listing content",
        "AUTO-APPROVE or AUTO-REJECT",
        "Send notifications to vendors",
        "Access user financial data"
      ],
      
      "kpis": [
        {
          "metric": "listings_flagged_before_approval",
          "target": "80% of low-quality listings caught before going live"
        },
        {
          "metric": "admin_time_saved",
          "target": "30% reduction in moderation time per listing"
        },
        {
          "metric": "false_positive_rate",
          "target": "< 20% of flagged listings dismissed by admin"
        }
      ],
      
      "success_definition_14_days": "At least 50% of new listings analyzed, admin feedback collected, false positive rate < 25%",
      
      "model": "google/gemini-3-flash-preview",
      "temperature": 0.3,
      "max_tokens": 1500
    },
    
    {
      "agent_id": "review-quality-scorer",
      "canonical_name": "Review Quality Scorer",
      "purpose": "Score review authenticity and quality to help admins identify suspicious or low-value reviews",
      "target_audience": ["admin"],
      "domains": ["reviews_trust", "admin_operations"],
      
      "inputs": {
        "tables_read": ["reviews", "profiles", "providers"],
        "fields_analyzed": [
          "rating", "title", "content", "pros", "cons",
          "visit_date", "is_verified_purchase", "helpful_count",
          "created_at", "user_id"
        ],
        "context_provided": {
          "review_id": "uuid",
          "review_data": "JSON object with review fields",
          "provider_context": "JSON object with provider info (optional)"
        }
      },
      
      "outputs": {
        "artifact_type": "review_quality_score",
        "schema": {
          "type": "object",
          "required": ["authenticity_score", "quality_score", "flags", "verdict"],
          "properties": {
            "authenticity_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Likelihood review is genuine (0=fake, 100=authentic)"
            },
            "quality_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Review helpfulness/quality score"
            },
            "sentiment": {
              "type": "string",
              "enum": ["positive", "neutral", "negative", "mixed"]
            },
            "flags": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": { 
                    "type": "string", 
                    "enum": [
                      "generic_language", 
                      "suspicious_timing", 
                      "incentivized_signal",
                      "competitor_mention",
                      "excessive_punctuation",
                      "unrelated_content",
                      "duplicate_pattern"
                    ] 
                  },
                  "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                  "evidence": { "type": "string" }
                }
              }
            },
            "verdict": {
              "type": "string",
              "enum": ["approve", "review", "suspicious", "reject_recommend"]
            },
            "themes": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Key topics mentioned in review"
            },
            "actionable_feedback": {
              "type": "string",
              "description": "Summary of constructive feedback for provider"
            },
            "ai_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "storage": "ai_artifacts table (artifact_type = 'review_quality_score')"
      },
      
      "trigger": {
        "events": [
          "review.created",
          "admin.review_moderation.opened",
          "admin.batch_review_analysis.requested"
        ],
        "frequency": "on-demand and on new review creation",
        "batch_support": true
      },
      
      "allowed_actions": [
        "Read review data",
        "Read associated provider data (for context)",
        "Read reviewer profile (for pattern detection)",
        "Generate quality/authenticity scores",
        "Store artifact to ai_artifacts",
        "Log invocation to ai_agent_logs"
      ],
      
      "forbidden_actions": [
        "UPDATE is_approved on reviews",
        "DELETE reviews",
        "MODIFY review content",
        "AUTO-APPROVE or AUTO-REJECT reviews",
        "Send notifications to reviewers",
        "Access reviewer financial data",
        "Block or ban users"
      ],
      
      "kpis": [
        {
          "metric": "suspicious_reviews_flagged",
          "target": "100% of suspicious reviews surfaced to admin"
        },
        {
          "metric": "admin_review_time",
          "target": "40% reduction in time to moderate reviews"
        },
        {
          "metric": "false_positive_rate",
          "target": "< 15% of flagged reviews marked genuine by admin"
        },
        {
          "metric": "fake_review_catch_rate",
          "target": "> 90% of confirmed fake reviews were flagged by AI"
        }
      ],
      
      "success_definition_14_days": "All new reviews scored, admin feedback collected, authenticity accuracy > 80%",
      
      "model": "google/gemini-3-flash-preview",
      "temperature": 0.3,
      "max_tokens": 1200
    }
  ],
  
  "shared_constraints": {
    "ai_boundary_contract": {
      "may": ["read", "analyze", "classify", "score", "summarize", "suggest", "notify humans"],
      "may_not": ["execute irreversible actions", "approve/reject entities", "change system state beyond logs/artifacts"]
    },
    "audit_requirements": {
      "correlation_id": "required",
      "logging": "ai_agent_logs",
      "artifacts": "ai_artifacts",
      "retention_days": 90
    }
  }
}
