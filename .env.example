# Supabase / Lovable Cloud (primary database)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# PEYLAA sales system (separate Supabase project, read-only anon key)
VITE_PEYLAA_SUPABASE_URL=
VITE_PEYLAA_SUPABASE_KEY=

# Google Maps (Maps JavaScript API + Places API + Geocoding)
# 1. Enable in Google Cloud Console: Maps JavaScript API, Places API, Geocoding API.
# 2. Enable Billing on the project (required by Google for Maps).
# 3. If key is restricted by HTTP referrer, add http://localhost:* and your production domain.
VITE_GOOGLE_MAPS_API_KEY=

# Set to "true" to bypass Coming Soon gate and test app without logging in (e.g. /map).
VITE_BYPASS_COMING_SOON=

# Sentry error monitoring (optional — errors are only reported in production)
VITE_SENTRY_DSN=

# These are configured as backend secrets (not in .env):
# STRIPE_SECRET_KEY              — Stripe payments
# STRIPE_WEBHOOK_SECRET          — Stripe webhook verification (platform events)
# STRIPE_CONNECT_WEBHOOK_SECRET  — Stripe Connect webhook signature (devmod-stripe-webhook)
# RESEND_API_KEY                 — Email via Resend
# FIRECRAWL_API_KEY              — Web scraping (managed by connector)
# LOVABLE_API_KEY                — Lovable AI features
# RENTALS_UNITED_ACCESS_KEY      — Rentals United API (rentals-united-sync edge function)
# RENTALS_UNITED_SECRET_KEY      — Rentals United API (rentals-united-sync edge function)
# ANTHROPIC_API_KEY              — Claude Vision OCR for KYC passport scanning (devmod-buyer-kyc)

# Developer Module — Notifications (backend secrets only)
# TELEGRAM_BOT_TOKEN             — Telegram Bot API token for broker notifications
# TELEGRAM_BROKER_CHAT_ID        — Telegram chat/channel ID to receive developer alerts
# BROKER_EMAIL                   — Broker's email address for lead notifications
# PLATFORM_EMAIL                 — Platform proxy email address
# MASKED_EMAIL_DOMAIN            — Domain for masked email channels (e.g. leads.bymyuno.com)
