# Supabase / Lovable Cloud
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Canonical public site URL (no trailing slash). Strongly recommended in production (Vercel).
# Used for password-reset redirect so it matches Supabase "Redirect URLs" (avoids www vs non-www mismatch).
# Example: https://myuno.app
# VITE_PUBLIC_APP_URL=

# Optional: override chat API (default POST /api/chat). Use full URL if SPA host has no /api route (e.g. Supabase Edge Function).
# VITE_CHAT_API_URL=https://xxxx.supabase.co/functions/v1/your-chat-fn

# Optional: admin password gate POST URL (default /api/admin/login). Use full URL if static host has no /api route.
# VITE_ADMIN_LOGIN_API_URL=https://xxxx.supabase.co/functions/v1/admin-login

# Google Maps (Maps JavaScript API + Places API + Geocoding)
# 1. Enable in Google Cloud Console: Maps JavaScript API, Places API, Geocoding API.
# 2. Enable Billing on the project (required by Google for Maps).
# 3. If key is restricted by HTTP referrer, add http://localhost:* and your production domain.
VITE_GOOGLE_MAPS_API_KEY=

# Set to "true" to bypass Coming Soon gate and test app without logging in (e.g. /map).
VITE_BYPASS_COMING_SOON=

# These are configured as backend secrets (not in .env):
# STRIPE_SECRET_KEY              — Stripe payments
# STRIPE_WEBHOOK_SECRET          — Stripe webhook verification
# RESEND_API_KEY                 — Email via Resend (notify-admin-order, notify-new-signup, etc.)
# FIRECRAWL_API_KEY              — Web scraping (managed by connector)
# LOVABLE_API_KEY                — Lovable AI features
# RENTALS_UNITED_ACCESS_KEY      — Rentals United API (rentals-united-sync edge function)
# RENTALS_UNITED_SECRET_KEY      — Rentals United API (rentals-united-sync edge function)
