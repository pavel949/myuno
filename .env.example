# Supabase / Lovable Cloud
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Google Maps (Maps JavaScript API + Places API + Geocoding)
# Enable: Maps JavaScript API, Places API, Geocoding API in Google Cloud Console.
# Restrict key by HTTP referrer (e.g. your domain + localhost) for production.
VITE_GOOGLE_MAPS_API_KEY=

# Set to "true" to bypass Coming Soon gate and test app without logging in (e.g. /map).
VITE_BYPASS_COMING_SOON=

# These are configured as backend secrets (not in .env):
# STRIPE_SECRET_KEY        — Stripe payments
# STRIPE_WEBHOOK_SECRET    — Stripe webhook verification
# GOOGLE_MAPS_API_KEY      — Google Maps (geocoding in edge functions)
# MAPBOX_PUBLIC_TOKEN       — Mapbox maps (legacy, migrated to Google)
# RESEND_API_KEY            — Email via Resend (notify-admin-order, notify-new-signup, notify-admin-partner-application, etc.)
# FIRECRAWL_API_KEY         — Web scraping (managed by connector)
# LOVABLE_API_KEY           — Lovable AI features
