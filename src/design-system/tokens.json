{
  "$schema": "myUNO DS2.0 — Navy Premium",
  "version": "2.0.0",

  "color": {
    "semantic": {
      "bg": {
        "primary": { "light": "220 20% 97%", "dark": "222 30% 6%", "description": "Page background" },
        "surface": { "light": "220 14% 99%", "dark": "222 25% 9%", "description": "Card / panel background" },
        "surfaceRaised": { "light": "0 0% 100%", "dark": "222 25% 11%", "description": "Elevated card background" },
        "surfaceOverlay": { "light": "220 16% 96%", "dark": "222 25% 14%", "description": "Overlay / dropdown" },
        "inverse": { "light": "222 47% 11%", "dark": "210 15% 95%", "description": "Inverse surface" }
      },
      "text": {
        "primary": { "light": "222 47% 11%", "dark": "210 15% 95%", "description": "Headings, primary text" },
        "secondary": { "light": "222 20% 38%", "dark": "220 10% 72%", "description": "Body copy, descriptions" },
        "muted": { "light": "220 12% 56%", "dark": "220 8% 55%", "description": "Hints, captions, placeholders" },
        "inverse": { "light": "0 0% 100%", "dark": "222 47% 11%", "description": "Text on accent surfaces" },
        "link": { "light": "224 55% 32%", "dark": "224 50% 58%", "description": "Interactive text" }
      },
      "border": {
        "default": { "light": "220 14% 84%", "dark": "222 14% 20%", "description": "Default dividers" },
        "strong": { "light": "220 14% 70%", "dark": "222 14% 30%", "description": "Emphasized borders" },
        "subtle": { "light": "220 14% 92%", "dark": "222 14% 14%", "description": "Ghost borders" }
      },
      "accent": {
        "primary": { "light": "224 55% 32%", "dark": "224 50% 58%", "description": "Brand navy" },
        "primaryHover": { "light": "224 55% 26%", "dark": "224 50% 64%", "description": "Hover state" },
        "success": { "light": "152 60% 34%", "dark": "152 58% 42%", "description": "Positive actions" },
        "warning": { "light": "38 85% 48%", "dark": "38 85% 52%", "description": "Caution" },
        "danger": { "light": "0 72% 50%", "dark": "0 65% 48%", "description": "Destructive" },
        "info": { "light": "210 75% 45%", "dark": "210 70% 52%", "description": "Informational" },
        "coral": { "light": "12 65% 52%", "dark": "12 65% 58%", "description": "Warm accent" },
        "teal": { "light": "180 55% 38%", "dark": "180 55% 48%", "description": "Cool accent" },
        "purple": { "light": "270 55% 50%", "dark": "270 50% 62%", "description": "Premium accent" },
        "cyan": { "light": "190 65% 40%", "dark": "190 60% 52%", "description": "Tech accent" }
      }
    }
  },

  "typography": {
    "fontFamily": {
      "display": "Syne, sans-serif",
      "body": "DM Sans, sans-serif",
      "mono": "JetBrains Mono, monospace"
    },
    "scale": {
      "display-lg": { "size": "2.5rem", "lineHeight": "1.15", "weight": 700, "tracking": "-0.025em", "font": "display" },
      "display-md": { "size": "2rem", "lineHeight": "1.15", "weight": 700, "tracking": "-0.025em", "font": "display" },
      "heading-lg": { "size": "1.5rem", "lineHeight": "1.2", "weight": 600, "tracking": "-0.02em", "font": "display" },
      "heading-md": { "size": "1.25rem", "lineHeight": "1.25", "weight": 600, "tracking": "-0.015em", "font": "display" },
      "heading-sm": { "size": "1.125rem", "lineHeight": "1.3", "weight": 600, "tracking": "-0.01em", "font": "display" },
      "body-lg": { "size": "1rem", "lineHeight": "1.65", "weight": 400, "tracking": "0.005em", "font": "body" },
      "body-md": { "size": "0.875rem", "lineHeight": "1.6", "weight": 400, "tracking": "0.005em", "font": "body" },
      "body-sm": { "size": "0.8125rem", "lineHeight": "1.5", "weight": 400, "tracking": "0.01em", "font": "body" },
      "caption": { "size": "0.75rem", "lineHeight": "1.4", "weight": 500, "tracking": "0.01em", "font": "body" },
      "overline": { "size": "0.625rem", "lineHeight": "1.2", "weight": 600, "tracking": "0.08em", "font": "body" }
    }
  },

  "spacing": {
    "base": 4,
    "scale": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px",
      "24": "96px"
    }
  },

  "elevation": {
    "0": { "shadow": "none", "description": "Flat — surface level" },
    "1": { "shadow": "0 1px 3px -1px hsl(222 47% 11% / 0.06), 0 1px 2px hsl(222 47% 11% / 0.04)", "description": "Resting cards" },
    "2": { "shadow": "0 2px 8px -2px hsl(222 47% 11% / 0.08), 0 1px 2px hsl(222 47% 11% / 0.05)", "description": "Raised cards" },
    "3": { "shadow": "0 8px 24px -4px hsl(224 55% 32% / 0.16), 0 2px 6px -1px hsl(222 47% 11% / 0.08)", "description": "Hover / active" },
    "4": { "shadow": "0 12px 32px -8px hsl(224 55% 32% / 0.2), 0 4px 12px -4px hsl(222 47% 11% / 0.1)", "description": "Modals / drawers" },
    "5": { "shadow": "0 20px 48px -12px hsl(224 55% 32% / 0.24), 0 8px 16px -4px hsl(222 47% 11% / 0.1)", "description": "Floating elements" }
  },

  "radius": {
    "none": "0px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "2xl": "20px",
    "full": "9999px"
  },

  "motion": {
    "duration": {
      "instant": "50ms",
      "fast": "100ms",
      "normal": "150ms",
      "slow": "250ms",
      "entrance": "300ms"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "spring": "cubic-bezier(0.175, 0.885, 0.32, 1.275)"
    }
  },

  "breakpoints": {
    "xs": "400px",
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1400px"
  }
}
