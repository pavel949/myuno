{
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap(.*).xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "buildCommand": "NODE_OPTIONS='--max-old-space-size=4096' npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "crm.bymyuno.com" }],
      "destination": "/index.html"
    },
    {
      "source": "/og/persona/:slug.svg",
      "destination": "https://kakkwibljrjsawxgnupk.supabase.co/functions/v1/og-persona?persona=:slug"
    },
    {
      "source": "/og/area/:slug.svg",
      "destination": "https://kakkwibljrjsawxgnupk.supabase.co/functions/v1/og-persona?area=:slug"
    },
    {
      "source": "/og/cluster/:slug.svg",
      "destination": "https://kakkwibljrjsawxgnupk.supabase.co/functions/v1/og-persona?cluster=:slug"
    },
    { "source": "/bible", "destination": "/bible/index.html" },
    { "source": "/bible/", "destination": "/bible/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "crm.bymyuno.com" }],
      "destination": "/capital",
      "permanent": false
    },
    { "source": "/properties", "destination": "/property", "permanent": true },
    { "source": "/properties/:path*", "destination": "/property/:path*", "permanent": true },
    { "source": "/offplan", "destination": "/newbuilds", "permanent": true },
    { "source": "/offplan/:path*", "destination": "/newbuilds/:path*", "permanent": true },
    { "source": "/property/offplan", "destination": "/newbuilds", "permanent": true },
    { "source": "/property/offplan/:path*", "destination": "/newbuilds/:path*", "permanent": true }
  ]
}
