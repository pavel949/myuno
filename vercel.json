{
  "framework": "vite",
  "buildCommand": "NODE_OPTIONS='--max-old-space-size=4096' npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "crm.bymyuno.com" }],
      "destination": "/index.html"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "crm.bymyuno.com" }],
      "destination": "/capital",
      "permanent": false
    }
  ]
}
